#!/bin/sh
# 개인 레포에 회사 메일로 커밋하는 것을 막는다
email=$(git var GIT_AUTHOR_IDENT | sed -E 's/.*<([^>]*)>.*/\1/')
case "$email" in
  *@pt.zigbang.com)
    echo "pre-commit: 회사 메일($email)로 커밋할 수 없습니다. git config user.email을 개인 메일로 바꾸세요." >&2
    exit 1
    ;;
esac

# 스테이징된 README의 편집기 서식 깨짐을 막는다 (고치기는 npm run check -- --fix)
readmes=$(git diff --cached --name-only --diff-filter=ACM | grep 'README\.md$' || true)
if [ -n "$readmes" ]; then
  node scripts/check-readme.js --staged $readmes || exit 1
fi
